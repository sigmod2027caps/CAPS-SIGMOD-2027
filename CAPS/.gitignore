# Downloaded / generated locally: the data directories ship the scripts that build their inputs, not the
# (large) inputs themselves; the one exception is the small Twitter file below.
code/flink-1.10.0/
# Java 8, Maven and 7-Zip downloaded by bootstrap_tools.sh when the machine does not have them
tools/
data/nexmark/*.txt
!data/nexmark/README.txt
data/taxis/taxis.txt
data/taxis/old_data/
data/taxis/archive/
# The real tweets data/tweets/twitter.txt (5.3 MB, 100K tweets, anonymized) are part of the artifact and committed.
# data/small holds 10% subsets of every input (SMALL=1, data/make_small.py), derived from the files above.
data/small/
# The input of the channel-cardinality experiment (data/synthetic_scale/generate_synthetic_scale.py, fixed seed)
data/synthetic_scale/*.txt

# Build outputs
venv/
**/target/
*.class
*.jar
!**/pom.xml

# Flink runtime and run logs
*.log
*.out

# Python bytecode
__pycache__/
*.pyc

# Editor / OS
.idea/
*.iml
.DS_Store

# Experiment results are not part of the repository: every number comes from your own run (see readme.md).
# The results of a run (CSVs, plot PDFs, LaTeX table snippets) are written next to the experiment that produces
# them and stay local.
experiments/**/small/
experiments/**/results*/
experiments/**/*.csv
experiments/**/*.pdf
experiments/**/*.tex
# per-run Flink REST records, sink files and captured query fixtures (large; the CSVs next to them are the results)
experiments/**/job.json
experiments/**/outputs_*.txt
*.ser
# cross-method verification: the sink files of the four methods (large on full data)
experiments/verify/work_*/
# channel-cardinality experiment: per-run work directories (verification outputs, fixtures, JMH logs)
experiments/channel_scaling/work/
# disorder / skew experiment: raw per-run work directories (traces, logs, sink files)
experiments/disorder/work_*/
# recovery experiment: raw per-run work directories (cluster configuration, id logs, REST records, run logs)
experiments/recovery/work_*/
experiments/channel_scaling_real/work*/
experiments/max_count/work_*/
experiments/nested_paths/work/
logs/
