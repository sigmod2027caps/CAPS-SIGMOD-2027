#!/usr/bin/env bash
# Stand-in for `flink run` that runs the job main in an in-process Flink mini cluster (no standalone cluster, no
# REST). Used by the measurements that need Flink's operator metrics (late records: a metric reporter is only wired
# up in this runtime) and by the output-equality checks; the timings and the traces of processing time come from the
# standalone cluster. Pinned to LOCAL_CORES (default 8-15, or all cores on a machine with fewer than 16) and
# niced; the heap is 20 GB, or half the RAM on a machine with less than 40 GB.
#   flink run --parallelism P --class CLASS JAR args...
set -euo pipefail
[[ $1 == run ]] && shift
[[ $1 == --parallelism ]] && { P=$2; shift 2; }
[[ $1 == --class ]] && { CLASS=$2; shift 2; }
JAR=$1; shift
DIST="$(cd "$(dirname "$0")/../../../.." && pwd)/code/flink-1.10.0/lib/flink-dist_2.11-1.10.0.jar"
export CAPS_PARALLELISM=$P
n=$(nproc)
(( n >= 16 )) && cores=8-15 || cores=0-$((n - 1))
ram_gb=$(( $(awk '/MemTotal/ {print $2}' /proc/meminfo) / 1048576 ))
(( ram_gb >= 40 )) && heap=20 || heap=$(( ram_gb / 2 > 1 ? ram_gb / 2 : 1 ))
exec nice -n 19 taskset -c "${LOCAL_CORES:-$cores}" java -Xmx"${INPROCESS_HEAP:-${heap}g}" -cp "$JAR:$DIST" "$CLASS" "$@"
